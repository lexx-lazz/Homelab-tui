# The script MUST stay UTF-8 with a BOM. PowerShell 5.1 reads BOM-less UTF-8
# as ANSI, which turns every box-drawing character into mojibake.
*.ps1 text eol=crlf

*.md   text eol=lf
*.json text eol=lf

# Server-side files must stay LF. A .sh with CRLF dies on Linux with
# "bad interpreter: /bin/bash^M", and these get scp'd straight from this
# working copy, so the working copy itself has to be LF - not just the blob.
*.sh   text eol=lf
*.py   text eol=lf
